#!/bin/bash
# Install arduino-cli + arduino:avr core for panelsdcc-connect sensor board flashing.
# Headless / non-interactive. Run as root (from postinst or manually).

set -e

CLI_DIR="/usr/lib/panelsdcc-connect/bin"
CLI_BIN="${CLI_DIR}/arduino-cli"
DATA_DIR="/var/lib/panelsdcc-connect/arduino"
GITHUB_API="https://api.github.com/repos/arduino/arduino-cli/releases/latest"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

error() { echo -e "${RED}ERROR:${NC} $1" >&2; exit 1; }
info() { echo -e "${GREEN}INFO:${NC} $1"; }
warn() { echo -e "${YELLOW}WARN:${NC} $1"; }

if [ "$EUID" -ne 0 ]; then
    error "This script must be run as root (use sudo)"
fi

for cmd in curl jq tar uname; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        error "$cmd is required but not installed"
    fi
done

ARCH=$(uname -m)
case "$ARCH" in
    aarch64|arm64) ASSET_ARCH="Linux_ARM64" ;;
    armv7l|armhf)  ASSET_ARCH="Linux_ARMv7" ;;
    armv6l)        ASSET_ARCH="Linux_ARMv6" ;;
    x86_64|amd64)  ASSET_ARCH="Linux_64bit" ;;
    i386|i686)     ASSET_ARCH="Linux_32bit" ;;
    *) error "Unsupported architecture: $ARCH" ;;
esac

info "Host architecture: $ARCH → arduino-cli asset $ASSET_ARCH"

info "Fetching latest arduino-cli release from GitHub..."
RELEASE_JSON=$(curl -s -f -H "User-Agent: panelsdcc-connect-arduino-install" "$GITHUB_API") || \
    error "Failed to fetch arduino-cli release metadata (network required)"

TAG=$(echo "$RELEASE_JSON" | jq -r '.tag_name')
DOWNLOAD_URL=$(echo "$RELEASE_JSON" | jq -r \
    --arg arch "$ASSET_ARCH" \
    '.assets[] | select(.name | test("arduino-cli_.*_" + $arch + "\\.tar\\.gz$")) | .browser_download_url' \
    | head -1)

if [ -z "$DOWNLOAD_URL" ] || [ "$DOWNLOAD_URL" = "null" ]; then
    error "No arduino-cli asset found for $ASSET_ARCH in release $TAG"
fi

info "Downloading $TAG ..."
TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT
curl -fsSL -o "$TMPDIR/arduino-cli.tgz" "$DOWNLOAD_URL" || error "Download failed"

tar -xzf "$TMPDIR/arduino-cli.tgz" -C "$TMPDIR"
if [ ! -f "$TMPDIR/arduino-cli" ]; then
    error "arduino-cli binary not found in archive"
fi

mkdir -p "$CLI_DIR"
install -m 755 "$TMPDIR/arduino-cli" "$CLI_BIN"
ln -sfn "$CLI_BIN" /usr/local/bin/arduino-cli 2>/dev/null || true

mkdir -p "$DATA_DIR"
if id -u dcc-io >/dev/null 2>&1; then
    chown -R dcc-io:dcc-io "$DATA_DIR"
fi
chmod 755 "$DATA_DIR"

export ARDUINO_DIRECTORIES_DATA="$DATA_DIR"
export ARDUINO_DIRECTORIES_DOWNLOADS="${DATA_DIR}/staging"
export ARDUINO_DIRECTORIES_USER="${DATA_DIR}/user"
mkdir -p "$ARDUINO_DIRECTORIES_DOWNLOADS" "$ARDUINO_DIRECTORIES_USER"
if id -u dcc-io >/dev/null 2>&1; then
    chown -R dcc-io:dcc-io "$DATA_DIR"
fi

info "Updating Arduino package index..."
"$CLI_BIN" core update-index || error "core update-index failed"

info "Installing arduino:avr core (Nano + Mega FQBNs)..."
"$CLI_BIN" core install arduino:avr || error "core install arduino:avr failed"

info "Verifying arduino:avr:nano ..."
"$CLI_BIN" board details -b arduino:avr:nano >/dev/null || \
    error "arduino:avr:nano not available after core install"

info "Verifying arduino:avr:mega ..."
"$CLI_BIN" board details -b arduino:avr:mega >/dev/null || \
    error "arduino:avr:mega not available after core install"

info "Installing esp32:esp32 core (ESP32 node boards)..."
"$CLI_BIN" core update-index || warn "esp32 index update failed (retry later)"
if "$CLI_BIN" core install esp32:esp32; then
    info "Verifying esp32:esp32:esp32 ..."
    "$CLI_BIN" board details -b esp32:esp32:esp32 >/dev/null || \
        warn "esp32:esp32:esp32 not listed yet — flash ESP32 after core settles"
else
    warn "esp32:esp32 core install failed (network / board manager). AVR Nano/Mega still OK."
fi

if id -u dcc-io >/dev/null 2>&1; then
    chown -R dcc-io:dcc-io "$DATA_DIR"
fi

info "Arduino toolchain ready:"
info "  cli:  $CLI_BIN"
info "  data: $DATA_DIR"
info "  fqbn: arduino:avr:nano, arduino:avr:mega, esp32:esp32:esp32 (when installed)"
exit 0
